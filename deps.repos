# 大体积 / 未改动的上游依赖（vcstool）
#
# 用法：
#   vcs import src < deps.repos     # 首次拉取（在仓库根目录执行）
#   vcs pull src                    # 后续更新
#
# 这些包**不入库**（见 .gitignore），只在这里固定版本。它们要么体积大
# （librealsense 78 MB、realsense-ros 94 MB），要么完全没改过，
# 放进来只会让 clone 变慢。
#
# 改过的上游在 src/ 下直接入库，各自带 UPSTREAM.md。
#
# 构建顺序见 src/README.md —— 其中 Livox-SDK2 / librealsense / kindr
# 必须先 `make install` 到 /usr/local，再 colcon build。

repositories:
  Livox-SDK2:
    type: git
    url: https://github.com/Livox-SDK/Livox-SDK2.git
    version: c0796f04c143143899c87a773d9f6b7136453c0b   # v1.5.2（master HEAD）

  librealsense:
    type: git
    url: https://github.com/IntelRealSense/librealsense.git
    version: dfd6aa91250f5c31521d72d627865417989bb4e7   # tag v2.58.3

  realsense-ros:
    type: git
    url: https://github.com/IntelRealSense/realsense-ros.git
    version: 60c850958d651130fc2cc3d10efb37ff5be93da5   # tag 4.58.3

# 说明：
#   kindr / kindr_ros 不在这里 —— 两者都有本地适配（CMake 版本下调、
#   rosidl DEPENDENCIES 补齐），已入库，见 src/kindr/UPSTREAM.md。
#   grid_map 也不在这里 —— 本机直接用 apt 的 ros-humble-grid-map-* (2.0.1)。
#   如需源码版本，用 https://github.com/ANYbotics/grid_map 的 humble 分支。
